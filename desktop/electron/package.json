{
  "name": "lexvault-app",
  "productName": "OpenLex",
  "version": "0.3.0",
  "description": "OpenLex — open-source, local-first legal AI. Statute research and document analysis on your machine.",
  "main": "main/main.js",
  "author": "OpenLex contributors",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:dev": "LEXVAULT_DEVTOOLS=1 LEXVAULT_DEV_BACKEND=http://127.0.0.1:8000 LEXVAULT_DEV_FRONTEND=http://localhost:5173 electron .",
    "prepare-resources": "node scripts/prepare-resources.js",
    "package": "node scripts/prepare-resources.js && electron-builder --publish never",
    "package:mac": "npm run package:mac:arm64 && npm run package:mac:x64",
    "package:mac:arm64": "node scripts/prepare-resources.js --mac --arm64 && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "node scripts/prepare-resources.js --mac --x64 && electron-builder --mac --x64 --publish never",
    "package:win": "node scripts/prepare-resources.js --win --x64 && electron-builder --win --x64 --publish never",
    "package:linux": "node scripts/prepare-resources.js --linux --x64 && electron-builder --linux --x64 --publish never",
    "smoke": "node scripts/smoke-packaged.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.lexvault.app",
    "productName": "OpenLex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "sidecars/**/*",
      "package.json",
      "!sidecars/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/client",
        "to": "client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/public_key.pem",
        "to": "public_key.pem"
      },
      {
        "from": "hardware-tiers.json",
        "to": "hardware-tiers.json"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "identity": null,
      "icon": "build/icon.icns",
      "artifactName": "OpenLex-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OpenLex-${version}-windows-${arch}-setup.${ext}",
      "icon": "build/icon.ico",
      "publisherName": [
        "OpenLex"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "openlex",
      "synopsis": "Open-source, local-first legal AI",
      "artifactName": "OpenLex-${version}-linux-x64.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "dmg": {
      "artifactName": "OpenLex-${version}-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "nsis": {
      "artifactName": "OpenLex-${version}-windows-${arch}-setup.${ext}",
      "differentialPackage": false
    }
  },
  "dependencies": {
    "hyparquet": "^1.18.0",
    "hyparquet-compressors": "^1.1.1"
  }
}
